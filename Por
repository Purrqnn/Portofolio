<!DOCTYPE html>
<html lang="id" data-theme="dark">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Portofolio Desain — Poster, Jersey, Produk</title>

    <!-- Google Fonts: Inter Tight (Display & UI) + JetBrains Mono (HUD Telemetry) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN for utility support Alongside Custom Architectural CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        /* ==========================================================================
           1. DESIGN TOKENS & THEME ENGINE (OBSIDIAN DARK & SWISS PAPER LIGHT)
           ========================================================================== */
        
         :root {
            /* Default: Igloo Obsidian Dark Mode */
            --bg-primary: #060608;
            --bg-elevated: #0d0e12;
            --bg-glass: rgba(13, 14, 18, 0.72);
            --bg-card: rgba(18, 19, 24, 0.68);
            --fg-primary: #f4f4f6;
            --fg-secondary: #9496a1;
            --fg-muted: #565864;
            --accent: #e30613;
            --accent-glow: rgba(227, 6, 19, 0.32);
            --accent-soft: rgba(227, 6, 19, 0.12);
            --status-green: #10b981;
            --line-hairline: rgba(244, 244, 246, 0.11);
            --line-strong: rgba(244, 244, 246, 0.28);
            --tile-bg: #111217;
            --grid-particle: rgba(244, 244, 246, 0.16);
            --shadow-card: 0 30px 60px -15px rgba(0, 0, 0, 0.75);
            --font-display: 'Inter Tight', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --hud-pad: clamp(14px, 2.2vw, 28px);
            --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
        }
        
         :root[data-theme="light"] {
            --bg-primary: #f4f3ef;
            --bg-elevated: #eae8e1;
            --bg-glass: rgba(244, 243, 239, 0.82);
            --bg-card: rgba(255, 255, 255, 0.78);
            --fg-primary: #090a0c;
            --fg-secondary: #494b54;
            --fg-muted: #7e808a;
            --accent: #e30613;
            --accent-glow: rgba(227, 6, 19, 0.22);
            --accent-soft: rgba(227, 6, 19, 0.08);
            --status-green: #059669;
            --line-hairline: rgba(9, 10, 12, 0.12);
            --line-strong: rgba(9, 10, 12, 0.85);
            --tile-bg: #e6e4dc;
            --grid-particle: rgba(9, 10, 12, 0.18);
            --shadow-card: 0 24px 48px -12px rgba(9, 10, 12, 0.12);
        }
        
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        
        html {
            scroll-behavior: smooth;
            background-color: var(--bg-primary);
            color: var(--fg-primary);
            font-family: var(--font-display);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            selection-background-color: var(--accent);
        }
        
         ::selection {
            background: var(--accent);
            color: #ffffff;
        }
        
        body {
            background-color: var(--bg-primary);
            color: var(--fg-primary);
            overflow-x: hidden;
            transition: background-color 0.5s var(--ease-out-expo), color 0.5s var(--ease-out-expo);
        }
        /* ==========================================================================
           2. INTERACTIVE BACKGROUND CANVAS & NOISE OVERLAY
           ========================================================================== */
        
        #bg-canvas {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            z-index: 0;
            pointer-events: none;
        }
        
        .noise-overlay {
            position: fixed;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            opacity: 0.035;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        }
        /* ==========================================================================
           3. IGLOO.INC FIXED ARCHITECTURAL HUD FRAME
           ========================================================================== */
        
        .hud-frame {
            position: fixed;
            inset: var(--hud-pad);
            border: 1px solid var(--line-hairline);
            pointer-events: none;
            z-index: 40;
            transition: border-color 0.4s ease;
        }
        /* Corner Crosshairs (+) */
        
        .hud-crosshair {
            position: absolute;
            width: 11px;
            height: 11px;
            pointer-events: none;
        }
        
        .hud-crosshair::before,
        .hud-crosshair::after {
            content: '';
            position: absolute;
            background: var(--fg-primary);
            opacity: 0.65;
        }
        
        .hud-crosshair::before {
            top: 5px;
            left: 0;
            width: 11px;
            height: 1px;
        }
        
        .hud-crosshair::after {
            top: 0;
            left: 5px;
            width: 1px;
            height: 11px;
        }
        
        .hud-tl {
            top: -6px;
            left: -6px;
        }
        
        .hud-tr {
            top: -6px;
            right: -6px;
        }
        
        .hud-bl {
            bottom: -6px;
            left: -6px;
        }
        
        .hud-br {
            bottom: -6px;
            right: -6px;
        }
        /* Top HUD Navigation Bar */
        
        .hud-header {
            position: fixed;
            top: var(--hud-pad);
            left: var(--hud-pad);
            right: var(--hud-pad);
            height: 58px;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            background: var(--bg-glass);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--line-hairline);
        }
        
        .brand-cluster {
            display: flex;
            align-items: center;
            gap: 14px;
            pointer-events: auto;
        }
        
        .brand-logo {
            font-weight: 800;
            font-size: 16px;
            letter-spacing: -0.02em;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }
        
        .brand-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            background: var(--accent);
            border-radius: 50%;
            box-shadow: 0 0 12px var(--accent);
        }
        
        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 4px 10px;
            border-radius: 999px;
            border: 1px solid var(--line-hairline);
            font-family: var(--font-mono);
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--fg-secondary);
            background: rgba(255, 255, 255, 0.02);
        }
        
        .status-led {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--status-green);
            box-shadow: 0 0 8px var(--status-green);
            animation: pulseLed 2s infinite ease-in-out;
        }
        
        @keyframes pulseLed {
            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }
            50% {
                opacity: 0.45;
                transform: scale(0.85);
            }
        }
        /* Section Pills Nav */
        
        .hud-nav {
            display: flex;
            align-items: center;
            gap: 4px;
            pointer-events: auto;
        }
        
        .hud-nav a {
            position: relative;
            font-family: var(--font-mono);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            text-decoration: none;
            color: var(--fg-secondary);
            padding: 7px 12px;
            border-radius: 6px;
            transition: all 0.25s var(--ease-out-expo);
        }
        
        .hud-nav a .nav-num {
            color: var(--fg-muted);
            margin-right: 4px;
            font-size: 10px;
        }
        
        .hud-nav a:hover {
            color: var(--fg-primary);
            background: rgba(255, 255, 255, 0.05);
        }
        
        .hud-nav a.active {
            color: var(--fg-primary);
            background: var(--accent-soft);
            border: 1px solid rgba(227, 6, 19, 0.35);
        }
        
        .hud-nav a.active .nav-num {
            color: var(--accent);
            font-weight: 700;
        }
        /* Right HUD Controls */
        
        .hud-controls {
            display: flex;
            align-items: center;
            gap: 8px;
            pointer-events: auto;
        }
        
        .hud-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: transparent;
            border: 1px solid var(--line-hairline);
            color: var(--fg-secondary);
            font-family: var(--font-mono);
            font-size: 11px;
            padding: 6px 11px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        
        .hud-btn:hover {
            color: var(--fg-primary);
            border-color: var(--fg-secondary);
            background: rgba(255, 255, 255, 0.04);
        }
        /* Bottom HUD Telemetry Bar */
        
        .hud-footer {
            position: fixed;
            bottom: var(--hud-pad);
            left: var(--hud-pad);
            right: var(--hud-pad);
            height: 44px;
            z-index: 45;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            background: var(--bg-glass);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-top: 1px solid var(--line-hairline);
            font-family: var(--font-mono);
            font-size: 11px;
            color: var(--fg-secondary);
            letter-spacing: 0.06em;
            pointer-events: none;
        }
        
        .hud-footer-left,
        .hud-footer-center,
        .hud-footer-right {
            display: flex;
            align-items: center;
            gap: 16px;
            pointer-events: auto;
        }
        
        .scroll-meter {
            width: 90px;
            height: 3px;
            background: var(--line-hairline);
            border-radius: 99px;
            overflow: hidden;
            position: relative;
        }
        
        .scroll-meter-fill {
            height: 100%;
            width: 0%;
            background: var(--accent);
            transition: width 0.1s linear;
        }
        /* Right Side Chapter Rail */
        
        .chapter-rail {
            position: fixed;
            right: calc(var(--hud-pad) + 18px);
            top: 50%;
            transform: translateY(-50%);
            z-index: 45;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        
        .rail-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            border: 1px solid var(--fg-muted);
            background: transparent;
            cursor: pointer;
            transition: all 0.3s var(--ease-out-expo);
            position: relative;
        }
        
        .rail-dot:hover {
            border-color: var(--fg-primary);
            transform: scale(1.25);
        }
        
        .rail-dot.active {
            background: var(--accent);
            border-color: var(--accent);
            box-shadow: 0 0 10px var(--accent);
            height: 24px;
            border-radius: 99px;
        }
        /* ==========================================================================
           4. SECTION ARCHITECTURE (IGLOO PER-SECTION SYSTEM)
           ========================================================================== */
        
        main {
            position: relative;
            z-index: 10;
        }
        
        .igloo-section {
            min-height: 100vh;
            width: 100%;
            padding: calc(var(--hud-pad) + 84px) calc(var(--hud-pad) + 32px) calc(var(--hud-pad) + 68px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            border-bottom: 1px solid var(--line-hairline);
        }
        
        .section-container {
            max-width: 1320px;
            width: 100%;
            margin: 0 auto;
        }
        /* Architectural 12-Column Swiss Grid */
        
        .swiss-grid {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 24px;
        }
        /* Section Index Header (Left Column Telemetry) */
        
        .sec-meta {
            grid-column: 1 / 4;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border-right: 1px solid var(--line-hairline);
            padding-right: 20px;
        }
        
        .sec-index-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: var(--font-mono);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--accent);
            margin-bottom: 12px;
        }
        
        .sec-index-title {
            font-weight: 800;
            font-size: 22px;
            letter-spacing: -0.02em;
            color: var(--fg-primary);
            margin-bottom: 8px;
        }
        
        .sec-index-desc {
            font-size: 14px;
            color: var(--fg-secondary);
            line-height: 1.55;
        }
        
        .sec-spec-box {
            margin-top: 32px;
            padding-top: 16px;
            border-top: 1px dashed var(--line-hairline);
            font-family: var(--font-mono);
            font-size: 11px;
            color: var(--fg-muted);
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        
        .sec-body {
            grid-column: 4 / 13;
            padding-left: 16px;
        }
        /* ==========================================================================
           5. SECTION 01: HERO MANIFESTO
           ========================================================================== */
        
        .hero-tag-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
            font-family: var(--font-mono);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--fg-secondary);
        }
        
        .hero-tag {
            padding: 5px 12px;
            border: 1px solid var(--line-hairline);
            border-radius: 4px;
            background: rgba(255, 255, 255, 0.02);
        }
        
        .hero-title {
            font-weight: 800;
            font-size: clamp(58px, 11vw, 158px);
            line-height: 0.86;
            letter-spacing: -0.045em;
            text-transform: uppercase;
            margin-bottom: 36px;
        }
        
        .hero-title .word-line {
            display: block;
            transition: transform 0.4s var(--ease-out-expo), color 0.3s ease;
        }
        
        .hero-title .word-line:hover {
            transform: translateX(12px);
        }
        
        .hero-title .accent-dot {
            color: var(--accent);
            display: inline-block;
        }
        
        .hero-title .stroke-word {
            color: transparent;
            -webkit-text-stroke: 2px var(--fg-primary);
            transition: all 0.35s ease;
        }
        
        .hero-title .stroke-word:hover {
            color: var(--fg-primary);
            -webkit-text-stroke: 0px transparent;
        }
        
        .hero-bottom-grid {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 24px;
            padding-top: 32px;
            border-top: 1px solid var(--line-strong);
            align-items: end;
        }
        
        .hero-lead {
            grid-column: 1 / 7;
            font-size: clamp(18px, 2vw, 24px);
            line-height: 1.38;
            font-weight: 500;
            color: var(--fg-primary);
            letter-spacing: -0.01em;
        }
        
        .hero-stats {
            grid-column: 7 / 10;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            border-left: 1px solid var(--line-hairline);
            padding-left: 20px;
        }
        
        .stat-item b {
            display: block;
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: var(--fg-primary);
        }
        
        .stat-item span {
            font-family: var(--font-mono);
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--fg-secondary);
        }
        
        .hero-cta-wrap {
            grid-column: 10 / 13;
            display: flex;
            justify-content: flex-end;
        }
        /* High-Craft Magnetic CTA Button */
        
        .btn-igloo {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            background: var(--accent);
            color: #ffffff;
            font-weight: 700;
            font-size: 15px;
            letter-spacing: -0.01em;
            padding: 18px 26px;
            border-radius: 6px;
            text-decoration: none;
            overflow: hidden;
            border: 1px solid var(--accent);
            box-shadow: 0 12px 32px var(--accent-glow);
            transition: all 0.3s var(--ease-out-expo);
            cursor: pointer;
        }
        
        .btn-igloo:hover {
            background: var(--fg-primary);
            color: var(--bg-primary);
            border-color: var(--fg-primary);
            transform: translateY(-2px);
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
        }
        
        .btn-igloo .btn-arrow {
            font-family: var(--font-mono);
            font-size: 14px;
            transition: transform 0.3s var(--ease-out-expo);
        }
        
        .btn-igloo:hover .btn-arrow {
            transform: translate(3px, -3px);
        }
        /* ==========================================================================
           6. SECTION 02: KARYA PILIHAN (3D ARTIFACT CARDS & BLUEPRINT MODE)
           ========================================================================== */
        
        .sec-heading-row {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: flex-end;
            gap: 16px;
            margin-bottom: 36px;
        }
        
        .sec-h2 {
            font-weight: 800;
            font-size: clamp(32px, 4.2vw, 56px);
            line-height: 0.96;
            letter-spacing: -0.035em;
        }
        
        .works-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            perspective: 1200px;
        }
        
        .artifact-card {
            position: relative;
            background: var(--bg-card);
            border: 1px solid var(--line-hairline);
            border-radius: 10px;
            padding: 16px;
            transition: transform 0.2s ease-out, border-color 0.3s ease, box-shadow 0.3s ease;
            transform-style: preserve-3d;
            cursor: pointer;
            overflow: hidden;
            backdrop-filter: blur(12px);
        }
        
        .artifact-card:hover {
            border-color: var(--accent);
            box-shadow: var(--shadow-card);
        }
        /* Specular Glare Effect on Hover */
        
        .artifact-glare {
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.14), transparent 60%);
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: 5;
        }
        
        .artifact-card:hover .artifact-glare {
            opacity: 1;
        }
        
        .artifact-top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-family: var(--font-mono);
            font-size: 10px;
            color: var(--fg-secondary);
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--line-hairline);
            letter-spacing: 0.08em;
        }
        
        .artifact-figure {
            aspect-ratio: 3 / 4;
            background: var(--tile-bg);
            border-radius: 6px;
            overflow: hidden;
            position: relative;
            margin-bottom: 14px;
            border: 1px solid var(--line-hairline);
        }
        
        .artifact-figure svg {
            width: 100%;
            height: 100%;
            display: block;
            transition: transform 0.6s var(--ease-out-expo);
        }
        
        .artifact-card:hover .artifact-figure svg {
            transform: scale(1.03);
        }
        /* Blueprint Mode Overlay inside SVG when toggled */
        
        body.blueprint-mode .artifact-figure svg {
            filter: invert(0.92) hue-rotate(180deg) contrast(1.15);
        }
        
        .artifact-inspect-pill {
            position: absolute;
            bottom: 12px;
            right: 12px;
            background: rgba(6, 6, 8, 0.85);
            color: #fff;
            font-family: var(--font-mono);
            font-size: 10px;
            padding: 5px 10px;
            border-radius: 4px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            opacity: 0;
            transform: translateY(6px);
            transition: all 0.25s ease;
        }
        
        .artifact-card:hover .artifact-inspect-pill {
            opacity: 1;
            transform: translateY(0);
        }
        
        .artifact-caption {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding-top: 8px;
            border-top: 2px solid var(--fg-primary);
        }
        
        .artifact-title {
            font-weight: 800;
            font-size: 18px;
            letter-spacing: -0.02em;
        }
        
        .artifact-sub {
            font-size: 13px;
            color: var(--fg-secondary);
            margin-top: 2px;
        }
        
        .artifact-year {
            font-family: var(--font-mono);
            font-size: 12px;
            font-weight: 600;
            color: var(--accent);
            background: var(--accent-soft);
            padding: 2px 8px;
            border-radius: 4px;
        }
        /* ==========================================================================
           7. SECTION 03: DAFTAR HARGA (INTERACTIVE LEDGER & CONFIGURATOR)
           ========================================================================== */
        
        .ledger-table {
            border-top: 2px solid var(--fg-primary);
            border-bottom: 2px solid var(--fg-primary);
        }
        
        .ledger-row {
            display: grid;
            grid-template-columns: 0.8fr 2.5fr 4fr 2fr 1.4fr;
            gap: 16px;
            padding: 22px 16px;
            border-bottom: 1px solid var(--line-hairline);
            align-items: center;
            cursor: pointer;
            transition: all 0.25s var(--ease-out-expo);
            position: relative;
        }
        
        .ledger-row:last-child {
            border-bottom: none;
        }
        
        .ledger-row:hover {
            background: rgba(227, 6, 19, 0.05);
            padding-left: 24px;
        }
        
        .ledger-row.selected {
            background: var(--accent-soft);
            border-left: 4px solid var(--accent);
            padding-left: 22px;
        }
        
        .ledger-code {
            font-family: var(--font-mono);
            font-size: 11px;
            color: var(--fg-muted);
        }
        
        .ledger-row.selected .ledger-code {
            color: var(--accent);
            font-weight: 700;
        }
        
        .ledger-name {
