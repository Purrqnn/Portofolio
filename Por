    <!-- ==========================================================================
         9. JAVASCRIPT ENGINE: CANVAS 3D GRID, CIPHER SCRAMBLE, HUD & CONFIGURATOR
         ========================================================================== -->
    <script>
        (function() {
            'use strict';

            /* ------------------------------------------------------------------
               A. INTERACTIVE ARCHITECTURAL CANVAS (IGLOO.INC DEPTH GRID)
               ------------------------------------------------------------------ */
            const canvas = document.getElementById('bg-canvas');
            const ctx = canvas.getContext('2d');
            let width = window.innerWidth;
            let height = window.innerHeight;
            let mouseX = width / 2;
            let mouseY = height / 2;
            let targetX = width / 2;
            let targetY = height / 2;
            let scrollY = window.scrollY;

            const nodes = [];
            const NODE_COUNT = 38;

            function resizeCanvas() {
                width = window.innerWidth;
                height = window.innerHeight;
                canvas.width = width * Math.min(window.devicePixelRatio || 1, 2);
                canvas.height = height * Math.min(window.devicePixelRatio || 1, 2);
                ctx.scale(Math.min(window.devicePixelRatio || 1, 2), Math.min(window.devicePixelRatio || 1, 2));
            }

            function initNodes() {
                nodes.length = 0;
                for (let i = 0; i < NODE_COUNT; i++) {
                    nodes.push({
                        x: Math.random() * width,
                        y: Math.random() * height,
                        vx: (Math.random() - 0.5) * 0.35,
                        vy: (Math.random() - 0.5) * 0.35,
                        size: Math.random() > 0.8 ? 3 : 1.5
                    });
                }
            }

            window.addEventListener('resize', () => {
                resizeCanvas();
                initNodes();
            });

            window.addEventListener('mousemove', (e) => {
                targetX = e.clientX;
                targetY = e.clientY;
            });

            function renderCanvas() {
                ctx.clearRect(0, 0, width, height);

                mouseX += (targetX - mouseX) * 0.06;
                mouseY += (targetY - mouseY) * 0.06;

                const isLight = document.documentElement.getAttribute('data-theme') === 'light';
                const strokeColor = isLight ? 'rgba(9, 10, 12, 0.055)' : 'rgba(244, 244, 246, 0.045)';
                const nodeColor = isLight ? 'rgba(9, 10, 12, 0.25)' : 'rgba(244, 244, 246, 0.22)';

                // Draw subtle reactive structural grid lines
                const gridSize = 110;
                const offsetX = ((mouseX - width / 2) * -0.025) % gridSize;
                const offsetY = ((mouseY - height / 2) * -0.025 - scrollY * 0.12) % gridSize;

                ctx.strokeStyle = strokeColor;
                ctx.lineWidth = 1;

                ctx.beginPath();
                for (let x = offsetX; x < width; x += gridSize) {
                    ctx.moveTo(x, 0);
                    ctx.lineTo(x, height);
                }
                for (let y = offsetY; y < height; y += gridSize) {
                    ctx.moveTo(0, y);
                    ctx.lineTo(width, y);
                }
                ctx.stroke();

                // Draw floating telemetry nodes & proximity links
                for (let i = 0; i < nodes.length; i++) {
                    const n = nodes[i];
                    n.x += n.vx;
                    n.y += n.vy;

                    if (n.x < 0) n.x = width;
                    if (n.x > width) n.x = 0;
                    if (n.y < 0) n.y = height;
                    if (n.y > height) n.y = 0;

                    const dx = mouseX - n.x;
                    const dy = mouseY - n.y;
                    const dist = Math.hypot(dx, dy);

                    // Draw small node cross or dot
                    ctx.fillStyle = dist < 180 ? '#e30613' : nodeColor;
                    ctx.fillRect(n.x - n.size / 2, n.y - n.size / 2, n.size, n.size);

                    if (dist < 170) {
                        ctx.beginPath();
                        ctx.strokeStyle = `rgba(227, 6, 19, ${(1 - dist / 170) * 0.28})`;
                        ctx.moveTo(n.x, n.y);
                        ctx.lineTo(mouseX, mouseY);
                        ctx.stroke();
                    }
                }

                requestAnimationFrame(renderCanvas);
            }

            resizeCanvas();
            initNodes();
            requestAnimationFrame(renderCanvas);

            /* ------------------------------------------------------------------
               B. CIPHER TEXT SCRAMBLE ENGINE (IGLOO.INC SIGNATURE EFFECT)
               ------------------------------------------------------------------ */
            const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789//[]—_';

            function scrambleText(el, finalString, duration = 420) {
                if (!el) return;
                let frame = 0;
                const totalFrames = Math.round(duration / 16);
                const timer = setInterval(() => {
                    frame++;
                    const progress = frame / totalFrames;
                    const revealCount = Math.floor(finalString.length * progress);
                    let output = '';
                    for (let i = 0; i < finalString.length; i++) {
                        if (finalString[i] === ' ') {
                            output += ' ';
                        } else if (i < revealCount) {
                            output += finalString[i];
                        } else {
                            output += CHARS[Math.floor(Math.random() * CHARS.length)];
                        }
                    }
                    el.textContent = output;
                    if (frame >= totalFrames) {
                        clearInterval(timer);
                        el.textContent = finalString;
                    }
                }, 16);
            }

            /* ------------------------------------------------------------------
               C. SCROLL SPY, REVEAL ANIMATIONS & HUD TELEMETRY
               ------------------------------------------------------------------ */
            const sections = document.querySelectorAll('.igloo-section');
            const navLinks = document.querySelectorAll('.hud-nav a');
            const railDots = document.querySelectorAll('.rail-dot');
            const activeChapterEl = document.getElementById('hud-active-chapter');
            const scrollPctEl = document.getElementById('hud-scroll-pct');
            const scrollFillEl = document.getElementById('scroll-bar-fill');
            let currentChapter = '';

            // Reveal elements on scroll
            const revealObserver = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, {
                threshold: 0.14
            });

            document.querySelectorAll('.reveal-up').forEach((el) => revealObserver.observe(el));

            // Section tracking observer
            const sectionObserver = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const id = entry.target.getAttribute('id');
                        const chapterName = entry.target.getAttribute('data-chapter');

                        navLinks.forEach((link) => {
                            link.classList.toggle('active', link.getAttribute('href') === '#' + id);
                        });

                        railDots.forEach((dot) => {
                            dot.classList.toggle('active', dot.getAttribute('href') === '#' + id);
                        });

                        if (chapterName && chapterName !== currentChapter) {
                            currentChapter = chapterName;
                            scrambleText(activeChapterEl, chapterName, 380);
                        }
                    }
                });
            }, {
                threshold: 0.42
            });

            sections.forEach((sec) => sectionObserver.observe(sec));

            window.addEventListener('scroll', () => {
                scrollY = window.scrollY;
                const docHeight = document.documentElement.scrollHeight - window.innerHeight;
                const pct = docHeight > 0 ? Math.min(100, Math.max(0, Math.round((scrollY / docHeight) * 100))) : 0;
                scrollPctEl.textContent = 'SCROLL ' + String(pct).padStart(3, '0') + '%';
                scrollFillEl.style.width = pct + '%';
            }, {
                passive: true
            });

            // Live WIB Clock
            const clockEl = document.getElementById('hud-clock');

            function updateClock() {
                const now = new Date();
                const timeStr = now.toLocaleTimeString('id-ID', {
                    hour12: false,
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                });
                clockEl.textContent = timeStr.replace(/\./g, ':') + ' WIB';
            }
            setInterval(updateClock, 1000);
            updateClock();

            /* ------------------------------------------------------------------
               D. 3D ARTIFACT TILT & BLUEPRINT SPECIFICATION MODAL
               ------------------------------------------------------------------ */
            const WORK_SPECS = {
                poster: {
                    code: 'ARCHIVE // 001 — PRINT & DIGITAL POSTER',
                    cat: 'POSTER ACARA & PROMOSI',
                    title: 'Poster acara (Lomba Seni)',
                    desc: 'Komposisi poster bergaya Swiss International dengan kontras tipografi tinggi, penataan informasi tanggal/lokasi yang terstruktur, dan profil warna siap cetak.',
                    files: 'JPG High-Res + PDF Siap Cetak',
                    rev: '2 Kali Revisi',
                    price: 'Rp35.000',
                    pkgName: 'Poster',
                    pkgPrice: 35000
                },
                jersey: {
                    code: 'ARCHIVE // 002 — SPORTSWEAR APPAREL',
                    cat: 'DESAIN JERSEY TIM & KELAS',
                    title: 'Jersey tim (FC 9B · No. 10)',
                    desc: 'Desain tampak depan dan belakang lengkap dengan penomoran punggung, nama pemain, serta garis pola siap kirim langsung ke vendor konveksi atau sublimasi.',
                    files: 'File Master Siap Konveksi (CDR/PDF/PNG)',
                    rev: '3 Kali Revisi',
                    price: 'Rp200.000',
                    pkgName: 'Jersey',
                    pkgPrice: 200000
                },
                label: {
                    code: 'ARCHIVE // 003 — PACKAGING DESIGN',
                    cat: 'LABEL & KEMASAN UMKM',
                    title: 'Label produk (Keripik Pisang)',
                    desc: 'Desain label kemasan produk yang menonjolkan identitas merek, berat bersih, keunggulan produk, dan tata letak bersih agar terlihat profesional di rak penjualan.',
                    files: 'File Siap Cetak Sesuai Ukuran Kemasan',
                    rev: '2 Kali Revisi',
                    price: 'Rp75.000',
                    pkgName: 'Label dan kemasan',
                    pkgPrice: 75000
                }
            };

            const artifactCards = document.querySelectorAll('.artifact-card');
            const artifactModal = document.getElementById('artifact-modal');
            const modalSvgHolder = document.getElementById('modal-svg-holder');
            let activeModalWorkKey = 'poster';

            artifactCards.forEach((card) => {
                const glare = card.querySelector('.artifact-glare');

                card.addEventListener('mousemove', (e) => {
                    const rect = card.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const centerX = rect.width / 2;
                    const centerY = rect.height / 2;

                    const rotateX = ((y - centerY) / centerY) * -6;
                    const rotateY = ((x - centerX) / centerX) * 6;

                    card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
                    if (glare) {
                        glare.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255,255,255,0.18), transparent 65%)`;
                    }
                });

                card.addEventListener('mouseleave', () => {
                    card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0)';
                });

                card.addEventListener('click', () => {
                    const key = card.getAttribute('data-work');
                    const spec = WORK_SPECS[key];
                    if (!spec) return;

                    activeModalWorkKey = key;
                    document.getElementById('modal-work-code').textContent = spec.code;
                    document.getElementById('modal-work-cat').textContent = spec.cat;
                    document.getElementById('modal-work-title').textContent = spec.title;
                    document.getElementById('modal-work-desc').textContent = spec.desc;
                    document.getElementById('modal-work-files').textContent = spec.files;
                    document.getElementById('modal-work-rev').textContent = spec.rev;
                    document.getElementById('modal-work-price').textContent = spec.price;

                    const svgClone = card.querySelector('svg').cloneNode(true);
                    modalSvgHolder.innerHTML = '';
                    modalSvgHolder.appendChild(svgClone);

                    artifactModal.classList.add('open');
                });
            });

            document.getElementById('close-artifact-modal').addEventListener('click', () => {
                artifactModal.classList.remove('open');
            });

            document.getElementById('modal-select-pkg-btn').addEventListener('click', () => {
                const spec = WORK_SPECS[activeModalWorkKey];
                if (spec) {
                    selectPackageByName(spec.pkgName);
                }
                artifactModal.classList.remove('open');
                document.getElementById('kontak').scrollIntoView({
                    behavior: 'smooth'
                });
            });

            // Blueprint Mode Toggle
            const blueprintBtn = document.getElementById('blueprint-toggle');
            blueprintBtn.addEventListener('click', () => {
                const active = document.body.classList.toggle('blueprint-mode');
                blueprintBtn.innerHTML = `<span>⊞ Mode Blueprint: ${active ? 'ON' : 'OFF'}</span>`;
            });

            /* ------------------------------------------------------------------
               E. INTERACTIVE PRICING LEDGER & WHATSAPP BRIEF GENERATOR
               ------------------------------------------------------------------ */
            let selectedPackage = 'Poster';
            let basePrice = 35000;
            let extraRevisions = 0;
            let studioWaNumber = '62XXXXXXXXXX';

            const ledgerRows = document.querySelectorAll('.ledger-row');
            const calcPkgName = document.getElementById('calc-pkg-name');
            const calcTotal = document.getElementById('calc-total');
            const calcDp = document.getElementById('calc-dp');
            const revCountEl = document.getElementById('rev-count');
            const briefPreviewText = document.getElementById('brief-preview-text');
            const waMainLink = document.getElementById('wa-main-link');

            function formatRupiah(num) {
                return 'Rp' + num.toLocaleString('id-ID');
            }

            function updateOrderSummary() {
                const total = basePrice + extraRevisions * 10000;
                const dp = Math.round(total / 2);

                calcPkgName.textContent = selectedPackage;
                revCountEl.textContent = extraRevisions + 'x Ekstra';
                calcTotal.textContent = formatRupiah(total);
                calcDp.textContent = `(DP 50%: ${formatRupiah(dp)})`;

                const revNote = extraRevisions > 0 ? ` + ${extraRevisions}x revisi tambahan` : '';
                const message = `Halo, saya ingin pesan desain *${selectedPackage}*${revNote} (Estimasi ${formatRupiah(total)} / DP 50% ${formatRupiah(dp)}). Berikut detail ukuran & referensinya:`;

                briefPreviewText.textContent = message;
                const cleanWa = studioWaNumber.replace(/[^0-9]/g, '') || '62XXXXXXXXXX';
                waMainLink.href = `https://wa.me/${cleanWa}?text=${encodeURIComponent(message)}`;
            }

            function selectPackageByName(pkgName) {
                ledgerRows.forEach((row) => {
                    const isMatch = row.getAttribute('data-pkg') === pkgName;
                    row.classList.toggle('selected', isMatch);
                    row.setAttribute('aria-checked', isMatch ? 'true' : 'false');
                    const badge = row.querySelector('.select-badge');
                    if (badge) {
                        badge.textContent = isMatch ? '✓ Terpilih' : 'Pilih Paket';
                    }
                    if (isMatch) {
                        selectedPackage = pkgName;
                        basePrice = parseInt(row.getAttribute('data-price'), 10) || 35000;
                    }
                });
                updateOrderSummary();
            }

            ledgerRows.forEach((row) => {
                row.addEventListener('click', () => {
                    selectPackageByName(row.getAttribute('data-pkg'));
                });
                row.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        selectPackageByName(row.getAttribute('data-pkg'));
                    }
                });
            });

            document.getElementById('rev-minus').addEventListener('click', () => {
                if (extraRevisions > 0) {
                    extraRevisions--;
                    updateOrderSummary();
                }
            });

            document.getElementById('rev-plus').addEventListener('click', () => {
                if (extraRevisions < 10) {
                    extraRevisions++;
                    updateOrderSummary();
                }
            });

            /* ------------------------------------------------------------------
               F. THEME SWITCHER, CLIPBOARD & STUDIO PROFILE CUSTOMIZER
               ------------------------------------------------------------------ */
            const themeBtn = document.getElementById('theme-toggle');
            const themeLabel = document.getElementById('theme-label');

            themeBtn.addEventListener('click', () => {
                const root = document.documentElement;
                const current = root.getAttribute('data-theme');
                const next = current === 'light' ? 'dark' : 'light';
                root.setAttribute('data-theme', next);
                themeLabel.textContent = next === 'light' ? '◑ DARK' : '◐ LIGHT';
            });

            // Toast helper
            const toastEl = document.getElementById('hud-toast');
            let toastTimer = null;

            function showToast(msg) {
                toastEl.textContent = msg;
                toastEl.classList.add('show');
                clearTimeout(toastTimer);
                toastTimer = setTimeout(() => {
                    toastEl.classList.remove('show');
                }, 2400);
            }

            function copyText(text, label) {
                const ta = document.createElement('textarea');
                ta.value = text;
                document.body.appendChild(ta);
                ta.select();
                try {
                    document.execCommand('copy');
                    showToast(label + ' DISALIN KE CLIPBOARD');
                } catch (err) {
                    showToast('GAGAL MENYALIN');
                }
                document.body.removeChild(ta);
            }

            document.getElementById('copy-brief-btn').addEventListener('click', () => {
                copyText(briefPreviewText.textContent, 'FORMAT PESAN ORDER');
            });

            document.getElementById('copy-wa-btn').addEventListener('click', () => {
                copyText(document.getElementById('wa-number-display').textContent, 'NOMOR WHATSAPP');
            });

            document.getElementById('copy-ig-btn').addEventListener('click', () => {
                copyText(document.getElementById('ig-handle-display').textContent, 'USERNAME INSTAGRAM');
            });

            // Studio Identity Customizer Modal
            const profileModal = document.getElementById('profile-modal');
            document.getElementById('edit-studio-btn').addEventListener('click', () => {
                profileModal.classList.add('open');
            });
            document.getElementById('close-profile-modal').addEventListener('click', () => {
                profileModal.classList.remove('open');
            });

            document.getElementById('profile-form').addEventListener('submit', (e) => {
                e.preventDefault();
                const newName = document.getElementById('input-studio-name').value.trim() || 'FATH STUDIO';
                const newWa = document.getElementById('input-wa-num').value.trim() || '6285122675027';
                const newIg = document.getElementById('input-ig-handle').value.trim() || '@fathstudioid';

                document.getElementById('studio-name-display').textContent = newName;
                document.getElementById('footer-studio-name').textContent = newName;
                document.getElementById('wa-number-display').textContent = newWa;
                document.getElementById('ig-handle-display').textContent = newIg;
                studioWaNumber = newWa;

                updateOrderSummary();
                profileModal.classList.remove('open');
                showToast('IDENTITAS STUDIO DIPERBARUI');
            });

            // Close modals on Escape or backdrop click
            window.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    artifactModal.classList.remove('open');
                    profileModal.classList.remove('open');
                }
            });

            [artifactModal, profileModal].forEach((modal) => {
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) modal.classList.remove('open');
                });
            });

            updateOrderSummary();
        })();
    </script>
</body>

</html>
